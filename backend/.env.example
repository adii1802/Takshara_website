# Server Port (Render sets process.env.PORT automatically)
PORT=5000

# Recipient Email for incoming website enquiries
EMAIL_TO=business@taksharatechnologies.com

# Frontend URL for CORS (e.g. https://your-website.vercel.app)
FRONTEND_URL=https://your-website.vercel.app

# SMTP Email Delivery Credentials (Gmail App Password or SMTP Service)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=business@taksharatechnologies.com
SMTP_PASS=your-gmail-app-password
