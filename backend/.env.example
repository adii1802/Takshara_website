# Backend Server Port
PORT=5000
NODE_ENV=development

# Allowed Frontend URL(s) for CORS (comma-separated if multiple)
FRONTEND_URL=http://localhost:5173,https://cairnlooptechnologies.com,https://www.cairnlooptechnologies.com

# Resend HTTPS Email Delivery Configuration
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here

# Verified Sender Address in Resend
# Must be on a verified domain in Resend, or onboarding@resend.dev during testing
CONTACT_FROM=Cairnloop Technologies <contact@cairnlooptechnologies.com>

# Destination Hostinger Business Inbox where customer inquiries will arrive
CONTACT_TO=contact@cairnlooptechnologies.com

# Reverse Proxy Trust (1 for Render / single proxy)
TRUST_PROXY=1
